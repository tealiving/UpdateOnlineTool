{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://update-online-tool.schema/manifest/v2",
  "title": "UpdateOnlineTool Manifest v2",
  "description": "NAS-only online update manifest contract for PyQt tools",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "app_id",
    "channel",
    "version",
    "mandatory",
    "min_supported_version",
    "published_at",
    "notes",
    "package"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "app_id": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "type": "string",
      "enum": ["stable", "beta", "nightly"]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-.+][0-9A-Za-z.-]+)?$"
    },
    "mandatory": {
      "type": "boolean"
    },
    "min_supported_version": {
      "type": "string",
      "minLength": 1
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "size", "sha256"],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "NAS-root-relative package path without parent traversal"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    }
  }
}
