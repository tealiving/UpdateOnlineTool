{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://update-online-tool.schema/manifest/v2",
  "title": "UpdateOnlineTool Manifest v2",
  "description": "AutomationManual 在线升级 manifest 契约，支持外网 HTTPS 与内网 file/相对路径源",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "app_id",
    "channel",
    "version",
    "mandatory",
    "min_supported_version",
    "published_at",
    "notes",
    "package"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "app_id": {
      "type": "string",
      "const": "automation-manual-studio"
    },
    "channel": {
      "type": "string",
      "enum": ["stable", "beta", "nightly"]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-.+][0-9A-Za-z.-]+)?$"
    },
    "mandatory": {
      "type": "boolean"
    },
    "min_supported_version": {
      "type": "string"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "size", "sha256"],
      "properties": {
        "url": {
          "type": "string",
          "description": "HTTPS URL、file URL 或不含 .. 的仓库相对路径"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "signature_url": {
          "type": "string",
          "description": "可选 detached signature URL 或相对路径"
        }
      }
    },
    "installer_kind": {
      "type": "string",
      "enum": ["custom_updater", "qt_ifw"],
      "description": "可选安装器类型；迁移期旧客户端可忽略"
    },
    "repository_url": {
      "type": "string",
      "description": "Qt IFW repository URL，支持 https:// 或 file://"
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["percentage", "cohort_salt"],
      "properties": {
        "percentage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "cohort_salt": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
