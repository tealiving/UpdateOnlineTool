{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://update-online-tool.schema/manifest/v1",
  "title": "UpdateOnlineTool Manifest",
  "description": "跨框架应用更新 manifest 通用规范，兼容 PyQt / Rust / Electron 等",
  "type": "object",
  "required": ["app_id", "channel", "version", "package"],
  "properties": {
    "app_id": {
      "type": "string",
      "description": "项目唯一标识，对应仓库子目录名",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "channel": {
      "type": "string",
      "enum": ["stable", "beta", "nightly"],
      "description": "发布通道"
    },
    "version": {
      "type": "string",
      "description": "语义化版本号",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+"
    },
    "release_notes": {
      "type": "string",
      "description": "版本变更说明"
    },
    "minimum_version": {
      "type": "string",
      "description": "可增量升级的最低版本，低于此版本需全量安装"
    },
    "released_at": {
      "type": "string",
      "format": "date-time",
      "description": "发布时间 ISO 8601"
    },
    "package": {
      "type": "object",
      "required": ["url", "sha256", "filename"],
      "properties": {
        "url": {
          "type": "string",
          "description": "下载地址，支持 file:// / https:// / http://",
          "format": "uri"
        },
        "size": {
          "type": "integer",
          "description": "文件字节数"
        },
        "sha256": {
          "type": "string",
          "description": "SHA-256 校验值",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "filename": {
          "type": "string",
          "description": "文件名"
        }
      }
    },
    "signature": {
      "type": "object",
      "description": "可选的数字签名，企业级发布时使用",
      "properties": {
        "algorithm": { "type": "string" },
        "value": { "type": "string" }
      }
    },
    "extra": {
      "type": "object",
      "description": "框架扩展字段，各项目自定义"
    }
  }
}
